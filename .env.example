# Nostr
# Relay URLs the client queries and the edge node publishes to.
NEXT_PUBLIC_RELAYS=ws://localhost:7777
# Edge node operator key (64-char hex). Generate with: npm run keys
NOSTR_SK=

# Amboss Payments (sandbox first: amb_test_...)
AMBOSS_API_KEY=
AMBOSS_WEBHOOK_SECRET=
AMBOSS_ENVIRONMENT_ID=
AMBOSS_WALLET_BTC_ID=
AMBOSS_WALLET_USDT_ID=
# Required by transactions.send; any non-empty value works in sandbox
TEAM_PASSWORD=Password123

# Bridge mode: "poll" (sandbox-safe, no public URL needed) or "webhook"
FX_BRIDGE_MODE=poll
BRIDGE_POLL_INTERVAL_SECONDS=10

# Edge node quote engine
FX_DEFAULT_SPREAD_BPS=150
FX_REFRESH_INTERVAL_SECONDS=60
FX_MAX_AMOUNT_BTC_SAT=
FX_MAX_AMOUNT_USDT_PRECISION6=
